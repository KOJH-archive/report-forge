{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://report-forge.local/report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "sources", "datasets", "sections"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "subtitle": { "type": "string", "maxLength": 180 },
    "author": { "type": "string", "maxLength": 100 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "disclosure": { "type": "string", "maxLength": 180 },
    "theme": { "enum": ["corporate", "editorial"] },
    "template": {
      "type": "object", "additionalProperties": false, "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "maxLength": 300 },
        "layouts": { "type": "object", "additionalProperties": false, "properties": {
          "cover": { "type": "integer", "minimum": 1 }, "flow": { "type": "integer", "minimum": 1 },
          "metrics": { "type": "integer", "minimum": 1 }, "chart": { "type": "integer", "minimum": 1 },
          "table": { "type": "integer", "minimum": 1 }, "references": { "type": "integer", "minimum": 1 }
        } },
        "roles": { "type": "object", "propertyNames": { "pattern": "^[1-9][0-9]*$" }, "additionalProperties": {
          "type": "object", "propertyNames": { "pattern": "^[0-9]+$" }, "additionalProperties": { "type": "string", "enum": ["clear", "keep", "title", "lead", "body", "footer", "page", "meta", "disclosure", "unit", "note", "metric1.label", "metric1.value", "metric1.description", "metric2.label", "metric2.value", "metric2.description", "metric3.label", "metric3.value", "metric3.description"] }
        } }
      }
    },
    "sources": { "type": "array", "maxItems": 100, "items": { "$ref": "#/definitions/source" } },
    "datasets": { "type": "array", "maxItems": 30, "items": { "$ref": "#/definitions/dataset" } },
    "metrics": { "type": "array", "maxItems": 40, "items": { "$ref": "#/definitions/metric" } },
    "sections": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/definitions/section" } }
  },
  "definitions": {
    "ids": { "type": "array", "uniqueItems": true, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 60 },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "publisher": { "type": "string", "maxLength": 120 },
        "date": { "type": "string", "maxLength": 30 },
        "url": { "type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 2000 },
        "locator": { "type": "string", "maxLength": 180 }
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false, "required": ["id", "file", "sourceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 60 },
        "file": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sheet": { "type": "string", "maxLength": 31 },
        "sourceIds": { "$ref": "#/definitions/ids", "minItems": 1 }
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "dataset", "column", "operation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "maxLength": 60 },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "dataset": { "type": "string" }, "column": { "type": "string" },
        "operation": { "enum": ["sum", "mean", "first", "last", "count", "growthPct"] },
        "unit": { "type": "string", "maxLength": 20 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "description": { "type": "string", "maxLength": 160 }
      }
    },
    "section": {
      "type": "object", "additionalProperties": false, "required": ["type", "title"],
      "properties": {
        "type": { "enum": ["summary", "metrics", "chart", "table", "comparison", "timeline", "text", "conclusion"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "lead": { "type": "string", "maxLength": 240 },
        "body": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 600 } },
        "bullets": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "sourceIds": { "$ref": "#/definitions/ids" },
        "metricIds": { "$ref": "#/definitions/ids", "minItems": 1, "maxItems": 3 },
        "dataset": { "type": "string" },
        "chartType": { "enum": ["line", "bar"] },
        "labelColumn": { "type": "string" },
        "series": { "type": "array", "minItems": 1, "maxItems": 3, "items": {
          "type": "object", "additionalProperties": false, "required": ["column", "name"],
          "properties": { "column": { "type": "string" }, "name": { "type": "string", "minLength": 1, "maxLength": 60 } }
        } },
        "unit": { "type": "string", "maxLength": 20 },
        "columns": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "type": "string" } },
        "options": { "type": "array", "minItems": 2, "maxItems": 12, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "strength", "tradeoff"],
          "properties": { "name": { "type": "string", "maxLength": 80 }, "strength": { "type": "string", "maxLength": 180 }, "tradeoff": { "type": "string", "maxLength": 180 } }
        } },
        "steps": { "type": "array", "minItems": 1, "maxItems": 30, "items": {
          "type": "object", "additionalProperties": false, "required": ["when", "title"],
          "properties": { "when": { "type": "string", "maxLength": 60 }, "title": { "type": "string", "maxLength": 180 }, "owner": { "type": "string", "maxLength": 80 } }
        } }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "metrics" } } }, "then": { "required": ["metricIds"] } },
        { "if": { "properties": { "type": { "const": "chart" } } }, "then": { "required": ["dataset", "chartType", "labelColumn", "series", "unit"] } },
        { "if": { "properties": { "type": { "const": "table" } } }, "then": { "required": ["dataset", "columns"] } },
        { "if": { "properties": { "type": { "const": "comparison" } } }, "then": { "required": ["options"] } },
        { "if": { "properties": { "type": { "const": "timeline" } } }, "then": { "required": ["steps"] } }
      ]
    }
  }
}
